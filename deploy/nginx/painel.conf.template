# nginx na frente do painel. O setup.sh troca __DOMINIO__ e instala em /etc/nginx/conf.d/painel.conf;
# o `certbot --nginx` então acrescenta o bloco 443 (certificado) e o redirecionamento de http para https.

# Log de acessos próprio (lido por deploy/acessos.sh e pelo `make acessos`): IP, hora, pedido, status, bytes, tempo,
# se veio do cache do nginx, navegador e de onde a pessoa chegou. Tem IP de visitante (dado pessoal): o logrotate do
# logrotate (deploy/setup.sh) guarda 90 dias e apaga; não publique esse arquivo.
log_format painel '$remote_addr [$time_iso8601] "$request" $status $body_bytes_sent $request_time $upstream_cache_status "$http_user_agent" "$http_referer"';

limit_req_zone $binary_remote_addr zone=painel_req:10m rate=20r/s;
proxy_cache_path /var/cache/nginx/painel levels=1:2 keys_zone=painel_cache:5m max_size=50m inactive=2m use_temp_path=off;

upstream painel_app {
    server 127.0.0.1:8765;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMINIO__;

    server_tokens off;
    access_log /var/log/painel/access.log painel;
    client_max_body_size 20k;                 # o painel só recebe GETs (o chat está desligado)
    limit_req zone=painel_req burst=60 nodelay;
    limit_req_status 429;
    add_header Strict-Transport-Security "max-age=15552000" always;

    location / {
        proxy_pass http://painel_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;      # sobrescreve: o visitante não consegue forjar o próprio IP
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # Microcache: 40 pessoas (ou 400) pedindo o mesmo JSON a cada 10 s viram ~1 pedido por 3 s ao painel.
    # Se o painel cair ou demorar, o nginx entrega a última resposta boa em vez de erro.
    location ~ ^/api(/mapa)?$ {
        proxy_pass http://painel_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_cache painel_cache;
        proxy_cache_key "$scheme$host$request_uri";
        proxy_cache_valid 200 3s;
        proxy_cache_lock on;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
    }

    # Contornos do IBGE: não mudam.
    location /geo/ {
        proxy_pass http://painel_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_cache painel_cache;
        proxy_cache_key "$scheme$host$request_uri";
        proxy_cache_valid 200 1h;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
    }
}
